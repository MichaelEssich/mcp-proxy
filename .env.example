# MCP Proxy Server Configuration

# =============================================================================
# PROXY SERVER CONFIGURATION
# =============================================================================

# Host to bind the proxy server
PROXY_HOST=127.0.0.1

# Port to bind the proxy server
PROXY_PORT=8000

# Enable debug mode (true/false)
DEBUG=false

# =============================================================================
# TARGET MCP SERVER CONFIGURATION
# =============================================================================

# URL of the target MCP server to proxy to
# This should be the full base URL (e.g., http://localhost:8080)
TARGET_MCP_URL=http://localhost:8080

# Timeout in seconds for requests to the target MCP server
TARGET_TIMEOUT=30

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Bearer token for authentication
# CHANGE THIS TO A STRONG, RANDOM TOKEN IN PRODUCTION (minimum 32 characters)
# The placeholder below intentionally fails the 32-char startup check.
BEARER_TOKEN=<set-a-random-token-at-least-32-chars>

# Header name for authentication (default: Authorization)
AUTH_HEADER_NAME=Authorization

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated list or * for all)
# Example: http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=*

# =============================================================================
# PROXY ROUTING CONFIGURATION
# =============================================================================

# Optional prefix for all proxy routes
# If set, all proxy requests must start with this prefix
# Example: /mcp or /api/mcp
PROXY_PREFIX=

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Maximum request size in bytes (default: 10MB)
MAX_REQUEST_SIZE=10000000

# Maximum response size from upstream in bytes (default: 50MB)
MAX_RESPONSE_SIZE=50000000

# Maximum concurrent in-flight proxied requests (default: 50)
# Bounds memory usage: limit x MAX_REQUEST_SIZE worst case
MAX_CONCURRENT_REQUESTS=50

# Comma-separated IPs/CIDRs of trusted reverse proxies (e.g. "172.16.0.0/12")
# Forwarded headers are only honored from these peers (loopback is always trusted)
#
# IMPORTANT: If cloudflared (or nginx) runs in a separate Docker container, it
# connects from a non-loopback IP (e.g. 172.x.x.x). You MUST set this to the
# Docker network CIDR, otherwise cf-connecting-ip / X-Forwarded-For headers will
# be ignored and all clients will share a single rate-limit bucket.
TRUSTED_PROXIES=

# Header to trust for the real client IP when behind a reverse proxy.
# Cloudflare Tunnel (default): cf-connecting-ip (Cloudflare overwrites it securely)
# nginx Proxy Manager: set to empty ("") to use rightmost X-Forwarded-For instead,
#   which nginx appends to and clients cannot forge on the right.
REAL_IP_HEADER=cf-connecting-ip
